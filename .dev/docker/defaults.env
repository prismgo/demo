# Versioned defaults for the local-only PrismGo test environment.
# Copy local.env.example to local.env to override ports or image tags.
TZ=Asia/Shanghai
BIND_ADDRESS=0.0.0.0

MYSQL_IMAGE=mysql:8.4
MYSQL_PORT=13306
MYSQL_DATABASE=prismgo_test
MYSQL_USER=prismgo
MYSQL_PASSWORD=prismgo
MYSQL_ROOT_PASSWORD=PrismGo_Root123!

POSTGRES_IMAGE=postgres:17
POSTGRES_PORT=15432
POSTGRES_DATABASE=prismgo_test
POSTGRES_USER=prismgo
POSTGRES_PASSWORD=prismgo

SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
SQLSERVER_PLATFORM=linux/amd64
SQLSERVER_PORT=11433
SQLSERVER_DATABASE=prismgo_test
SQLSERVER_SA_PASSWORD=PrismGo_Test123!

REDIS_IMAGE=redis:7.4-alpine
REDIS_PORT=16379

RABBITMQ_IMAGE=rabbitmq:4.1-management
RABBITMQ_PORT=15673
RABBITMQ_MANAGEMENT_PORT=25673
RABBITMQ_USER=prismgo
RABBITMQ_PASSWORD=prismgo
RABBITMQ_VHOST=/
