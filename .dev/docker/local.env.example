# Optional local overrides. Copy this file to local.env; local.env is ignored.
# Change host ports when another local service already occupies a default port.
# MYSQL_PORT=13306
# POSTGRES_PORT=15432
# SQLSERVER_PORT=11433
# REDIS_PORT=16379
# RABBITMQ_PORT=15673
# RABBITMQ_MANAGEMENT_PORT=25672

# Image versions may also be overridden for compatibility testing.
# MYSQL_IMAGE=mysql:8.4
# POSTGRES_IMAGE=postgres:17
# SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
# REDIS_IMAGE=redis:7.4-alpine
# RABBITMQ_IMAGE=rabbitmq:4.1-management
