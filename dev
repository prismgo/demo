#!/usr/bin/env bash
set -euo pipefail

dev_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
workspace_root="$(cd "${dev_root}/.." && pwd)"

ensure_agent_link() {
    local link_path="$1"

    if [[ -L "${link_path}" && "$(readlink "${link_path}")" == "dev/AGENTS.md" ]]; then
        return
    fi
    if [[ -e "${link_path}" || -L "${link_path}" ]]; then
        echo "Refusing to replace existing path: ${link_path}" >&2
        exit 1
    fi
    ln -s "dev/AGENTS.md" "${link_path}"
}

ensure_repository() {
    local directory_name="$1"
    local remote_url="$2"
    local repository_path="${workspace_root}/${directory_name}"

    if [[ -d "${repository_path}" ]]; then
        return
    fi
    git clone "${remote_url}" "${repository_path}"
}

ensure_env_file() {
    local env_file="${dev_root}/.env"

    if [[ -e "${env_file}" ]]; then
        return
    fi
    cp "${dev_root}/.env.example" "${env_file}"
}

ensure_go_workspace() {
    local workspace_file="${workspace_root}/go.work"

    if [[ ! -e "${workspace_file}" ]]; then
        (
            cd "${workspace_root}"
            go work init ./dev ./framework
        )
        return
    fi

    (
        cd "${workspace_root}"
        go work use ./dev ./framework
    )
}

install_framework_dependencies() {
    (
        cd "${workspace_root}/framework"
        go mod download
    )
}

if [[ "${1:-}" == "init" ]]; then
    ensure_agent_link "${workspace_root}/AGENTS.md"
    ensure_agent_link "${workspace_root}/CLAUDE.md"
    ensure_repository framework git@github.com:prismgo/framework.git
    ensure_repository docs git@github.com:prismgo/docs.git
    ensure_env_file
    ensure_go_workspace
    install_framework_dependencies
    exit 0
fi

exec "${dev_root}/.dev/scripts/test-environment.sh" "$@"
